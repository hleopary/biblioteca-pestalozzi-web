@startuml
hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontSize 14
skinparam nodesep 45
skinparam ranksep 45
title Modelo entidad-relación implementado\nSistema Web Biblioteca Pestalozzi

entity "USUARIOS" as usuarios {
  * id: INTEGER <<PK>>
  --
  * username: TEXT <<UNIQUE>>
  * password_hash: TEXT
  * nombre: TEXT
  email: TEXT
  created_at: DATETIME
}

entity "HORARIOS" as horarios {
  * id: INTEGER <<PK>>
  --
  * dia_orden: INTEGER
  * dia_nombre: TEXT
  * horario_texto: TEXT
  * activo: INTEGER
  updated_at: DATETIME
}

entity "VISITAS" as visitas {
  * id: INTEGER <<PK>>
  --
  * institucion: TEXT
  * responsable: TEXT
  * telefono: TEXT
  * email: TEXT
  * nivel: TEXT
  * alumnos_cant: INTEGER
  * fecha_preferida: TEXT
  * turno: TEXT
  observaciones: TEXT
  * estado: TEXT
  created_at: DATETIME
}

entity "NOVEDADES" as novedades {
  * id: INTEGER <<PK>>
  --
  * orden: INTEGER
  * categoria: TEXT
  * categoria_color: TEXT
  * fecha_texto: TEXT
  * titulo: TEXT
  * descripcion: TEXT
  * activa: INTEGER
  created_at: DATETIME
}

entity "NOTAS" as notas {
  * id: INTEGER <<PK>> (id = 1)
  --
  * contenido: TEXT
  updated_at: DATETIME
}

@enduml
